# podcast-studio secrets template. Copy to .env (chmod 600) and fill in. Never commit .env.
# Values already exported in the shell take precedence over .env.

# Google Cloud Text-to-Speech API key (tts.engine: google)
GOOGLE_TTS_API_KEY=

# CLOVA Voice (NCP AI·NAVER API application, tts.engine: clova)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=

# Google OAuth client JSON (Desktop app) for YouTube upload. Keep it outside the repo.
YOUTUBE_CLIENT_SECRETS=~/.config/podcast-studio/client_secret.json
# Optional: token path (default ~/.config/podcast-studio/youtube-token.json)
# YOUTUBE_TOKEN=

# ffmpeg with libass/freetype for subtitles (render_video, synth). Not a secret.
# e.g. /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFMPEG=
